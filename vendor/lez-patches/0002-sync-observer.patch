+//! Progress reporting for [`crate::WalletCore::sync_to_block_with_observer`].
+
+use std::{ops::RangeInclusive, time::Duration};
+
+use lee_core::BlockId;
+
+/// Receives progress of a block sync, so embedders can drive their own UI instead of stdout.
+///
+/// All methods default to doing nothing.
+pub trait SyncObserver: Send {
+    /// Sync is about to fetch and process `blocks`.
+    fn on_start(&mut self, _blocks: RangeInclusive<BlockId>) {}
+
+    /// `block_id` was processed and the storage persisted.
+    fn on_block(&mut self, _block_id: BlockId) {}
+
+    /// Sync reached `block_id` after `elapsed`.
+    fn on_finish(&mut self, _block_id: BlockId, _elapsed: Duration) {}
+
+    /// Informational message.
+    fn on_message(&mut self, _message: &str) {}
+}
+
+/// Default observer reproducing the wallet CLI output: messages on stdout and a progress bar.
+#[derive(Default)]
+pub struct CliSyncObserver {
+    bar: Option<indicatif::ProgressBar>,
+}
+
+#[expect(
+    clippy::print_stdout,
+    reason = "This observer exists to print sync progress for the CLI"
+)]
+impl SyncObserver for CliSyncObserver {
+    fn on_start(&mut self, blocks: RangeInclusive<BlockId>) {
+        let num_of_blocks = blocks
+            .end()
+            .saturating_sub(blocks.start().saturating_sub(1));
+        println!(
+            "Syncing to block {}. Blocks to sync: {num_of_blocks}",
+            blocks.end()
+        );
+        self.bar = Some(indicatif::ProgressBar::new(num_of_blocks));
+    }
+
+    fn on_block(&mut self, _block_id: BlockId) {
+        if let Some(bar) = &self.bar {
+            bar.inc(1);
+        }
+    }
+
+    fn on_finish(&mut self, block_id: BlockId, elapsed: Duration) {
+        if let Some(bar) = self.bar.take() {
+            bar.finish();
+        }
+        println!("Synced to block {block_id} in {elapsed:?}");
+    }
+
+    fn on_message(&mut self, message: &str) {
+        println!("{message}");
+    }
+}
