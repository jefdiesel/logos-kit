+impl FileBackend {
+    #[must_use]
+    pub const fn new(path: PathBuf) -> Self {
+        Self { path }
+    }
+
+    #[must_use]
+    pub fn path(&self) -> &Path {
+        &self.path
+    }
+}
+
+impl StorageBackend for FileBackend {
+    fn load(&self) -> Result<Option<Vec<u8>>> {
+        #[expect(
+            clippy::wildcard_enum_match_arm,
+            reason = "We want to provide a specific error message for not found case"
+        )]
+        match std::fs::read(&self.path) {
+            Ok(bytes) => Ok(Some(bytes)),
+            Err(err) => match err.kind() {
+                std::io::ErrorKind::NotFound => Ok(None),
+                _ => anyhow::bail!("IO error {err:#?}"),
+            },
+        }
+    }
+
+    fn save(&self, bytes: &[u8]) -> Result<()> {
+        let mut file = std::fs::File::create(&self.path).context("Failed to create file")?;
+        file.write_all(bytes).context("Failed to write to file")?;
+        file.sync_all().context("Failed to sync file")?;
+
+        Ok(())
+    }
+}
