+/// Persistence medium for the serialized wallet [`Storage`].
+///
+/// [`FileBackend`] keeps the historical plaintext JSON file. Embedders can plug in their own
+/// backend (e.g. encrypting at rest or debouncing writes) via
+/// [`crate::WalletCore::new_with_storage_backend`] or [`crate::WalletCore::set_storage_backend`].
+pub trait StorageBackend: Send + Sync {
+    /// Returns the stored bytes, or `None` if nothing has been stored yet.
+    fn load(&self) -> Result<Option<Vec<u8>>>;
+
+    /// Durably replaces the stored bytes.
+    fn save(&self, bytes: &[u8]) -> Result<()>;
+}
+
+/// Default [`StorageBackend`]: a plaintext file at a fixed path.
+pub struct FileBackend {
+    path: PathBuf,
+}
