+/// Signs `message_hash` for each of `signers`, in order.
+pub fn sign_message(
+    wallet: &WalletCore,
+    signers: &[TxSigner],
+    keycard_pin: Option<&str>,
+    message_hash: [u8; 32],
+) -> Result<Vec<(Signature, PublicKey)>> {
+    let mut keycard: Option<KeycardWallet> = None;
+    let mut sigs = Vec::with_capacity(signers.len());
+    for signer in signers {
+        sigs.push(match signer {
+            TxSigner::Local(account_id) => {
+                let key = wallet
+                    .get_account_public_signing_key(*account_id)
+                    .with_context(|| format!("Signing key of {account_id} not found"))?;
+                (
+                    Signature::new(key, &message_hash),
+                    PublicKey::new_from_private_key(key),
+                )
+            }
+            TxSigner::Keycard { key_path, .. } => {
+                if keycard.is_none() {
+                    let pin = keycard_pin.context("Keycard PIN is required to sign")?;
+                    let mut connected = KeycardWallet::new()?;
+                    connected.connect(pin)?;
+                    keycard = Some(connected);
+                }
+                keycard
+                    .as_mut()
+                    .expect("Keycard is connected above")
+                    .sign_message_for_path(key_path, &message_hash)?
+            }
+        });
+    }
+
+    Ok(sigs)
+}
